# Username Git của quản lý, độc lập với tên nhân viên hiển thị.
VP_MANAGER_USERNAME=tiennm55
# Nhánh gốc để tạo feature/<task-id> khi chưa tồn tại.
VP_FEATURE_BASE=master

# Executable thật hoặc đường dẫn tuyệt đối tới Codex CLI (không kèm tham số).
VP_CODEX_BIN=codex
# Để trống để dùng model từ cấu hình Codex local.
VP_CODEX_MODEL=
# Tối đa số project chạy đồng thời; mỗi project luôn chỉ có một task chạy.
VP_MAX_CONCURRENT=2
VP_RUN_TIMEOUT_MINUTES=60
# Cho phép lệnh bên trong sandbox Codex dùng mạng nếu đặt 1. Mặc định tắt.
VP_CODEX_NETWORK=0
